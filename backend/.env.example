# Copy to .env and fill in real values. Never commit .env itself.

PORT=4000

# Option A - hosted Postgres (Supabase, Render, Railway).
# Use the "Connection string / URI" from your provider.
DATABASE_URL=

# Option B - local Postgres. Only used if DATABASE_URL is empty.
PGHOST=localhost
PGPORT=5432
PGDATABASE=vjds_fertility
PGUSER=postgres
PGPASSWORD=
